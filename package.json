{
  "name": "school-photo-booking",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator --port 5174",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:rules": "node scripts/with-emulator.mjs firestore \"vitest run tests/rules --testTimeout=20000\"",
    "emulators": "firebase emulators:start --project demo-photo-booking",
    "test:e2e": "node scripts/with-emulator.mjs auth,firestore \"playwright test\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.34.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  }
}
